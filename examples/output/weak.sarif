        {
          "ruleId": "consenters-single-host",
          "ruleIndex": 11,
          "level": "warning",
          "message": {
            "text": "All 2 consenters in EtcdRaft.Consenters are on the host raft.harbor.test, so one host failure stops ordering. This is a best practice of this tool, not a rule in the Fabric documentation. Fix: Put each consenter on its own host, so that one failure cannot stop ordering."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/weak/configtx.yaml"
                },
                "region": {
                  "startLine": 181,
                  "startColumn": 9
                }
              }
            }
          ],
          "properties": {
            "kind": "best practice",
            "profiles": [
              "TwoNodeRaft"
            ]
          }
        },
        {
          "ruleId": "raft-consenter-count",
          "ruleIndex": 9,
          "level": "warning",
          "message": {
            "text": "EtcdRaft.Consenters lists 2 consenters. The documentation says a production network should use a multi-node ordering service and shows a set of three; a majority of consenters must be up to order. The minimum of 3 is a best practice of this tool. Fix: List at least three consenters, each on its own host."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/weak/configtx.yaml"
                },
                "region": {
                  "startLine": 181,
                  "startColumn": 9
                }
              }
            }
          ],
          "properties": {
            "kind": "best practice",
            "profiles": [
              "TwoNodeRaft"
            ]
          }
        },
        {
          "ruleId": "capabilities-missing",
          "ruleIndex": 14,
          "level": "warning",
          "message": {
            "text": "The Application group has no Capabilities, so the channel does not say which level of binaries may take part. The documentation sets all three groups. Fix: Add Capabilities with the level the binaries of the network support, set to true."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/weak/configtx.yaml"
                },
                "region": {
                  "startLine": 191,
                  "startColumn": 5
                }
              }
            }
          ],
          "properties": {
            "kind": "documented",
            "profiles": [
              "TwoNodeRaft"
            ]
          }
        },
        {
          "ruleId": "bft-consenter-count",
          "ruleIndex": 10,
          "level": "warning",
          "message": {
            "text": "ConsenterMapping lists 3 consenters. The sample file says a BFT set needs at least 3F+1 servers to tolerate F failures, so at least four for one failure. Fix: List at least 3F+1 consenters for the F failures the network is to tolerate, so at least four."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/weak/configtx.yaml"
