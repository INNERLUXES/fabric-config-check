          "ruleIndex": 14,
          "level": "warning",
          "message": {
            "text": "The Orderer group has no Capabilities, so the channel does not say which level of binaries may take part. The documentation sets all three groups. Fix: Add Capabilities with the level the binaries of the network support, set to true."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/weak/configtx.yaml"
                },
                "region": {
                  "startLine": 178,
                  "startColumn": 5
                }
              }
            }
          ],
          "properties": {
            "kind": "documented",
            "profiles": [
              "TwoNodeRaft"
            ]
