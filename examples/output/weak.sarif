              }
            }
          ],
          "properties": {
            "kind": "best practice",
            "profiles": [
              "DevSolo"
            ]
          }
        },
        {
          "ruleId": "single-organization",
          "ruleIndex": 3,
          "level": "warning",
          "message": {
            "text": "The consortium HarborConsortium lists one organization, HarborOrg (MSP ID HarborMSP), so no other organization is a member. This is a best practice of this tool, not a rule in the Fabric documentation. Fix: List every organization that is to be a member, so that the policies have more than one party to agree."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/weak/configtx.yaml"
                },
                "region": {
                  "startLine": 172,
                  "startColumn": 9
                }
              }
            }
          ],
          "properties": {
            "kind": "best practice",
            "profiles": [
              "DevSolo"
            ]
          }
        },
        {
          "ruleId": "capabilities-missing",
          "ruleIndex": 14,
          "level": "warning",
          "message": {
            "text": "The Channel group has no Capabilities, so the channel does not say which level of binaries may take part. The documentation sets all three groups. Fix: Add Capabilities with the level the binaries of the network support, set to true."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/weak/configtx.yaml"
                },
                "region": {
                  "startLine": 177,
                  "startColumn": 3
                }
              }
            }
          ],
          "properties": {
            "kind": "documented",
            "profiles": [
              "TwoNodeRaft"
            ]
          }
        },
        {
          "ruleId": "batch-settings-missing",
          "ruleIndex": 13,
          "level": "warning",
          "message": {
            "text": "The Orderer section sets no BatchTimeout. The documentation and the sample file set it to say how often a block is cut. Fix: Set BatchTimeout and BatchSize with MaxMessageCount, AbsoluteMaxBytes and PreferredMaxBytes, as the sample file does."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/weak/configtx.yaml"
                },
                "region": {
                  "startLine": 178,
                  "startColumn": 5
                }
              }
            }
          ],
          "properties": {
            "kind": "documented",
            "profiles": [
              "TwoNodeRaft"
            ]
          }
        },
        {
          "ruleId": "batch-settings-missing",
          "ruleIndex": 13,
          "level": "warning",
          "message": {
            "text": "The Orderer section sets no BatchSize. The documentation and the sample file set MaxMessageCount, AbsoluteMaxBytes and PreferredMaxBytes to say how large a block is. Fix: Set BatchTimeout and BatchSize with MaxMessageCount, AbsoluteMaxBytes and PreferredMaxBytes, as the sample file does."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/weak/configtx.yaml"
                },
                "region": {
